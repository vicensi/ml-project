# Copy to .env (local) — never commit .env. Production values come from a secret manager.
TSP_ENVIRONMENT=local
TSP_LOG_LEVEL=INFO

# --- Postgres (one server, separate databases/roles per application) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-admin
APP_DB_NAME=tsplatform
APP_DB_USER=tsp_app
APP_DB_PASSWORD=change-me-app
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=tsp_mlflow
MLFLOW_DB_PASSWORD=change-me-mlflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=tsp_airflow
AIRFLOW_DB_PASSWORD=change-me-airflow
FEAST_DB_NAME=feast
FEAST_DB_USER=tsp_feast
FEAST_DB_PASSWORD=change-me-feast
TEST_DB_NAME=tsplatform_test
# Feast connects with TLS by default. The local postgres container has no TLS -> disable.
# Production: require / verify-full. Keep DB passwords URL-safe (the Feast registry uses a URL).
APP_DB_SSLMODE=disable

# Application connection (the compose service 'postgres' is the host inside the network)
TSP_DB_HOST=postgres
TSP_DB_PORT=5432
TSP_DB_NAME=tsplatform
TSP_DB_USER=tsp_app
TSP_DB_PASSWORD=change-me-app

# --- Synthetic data generator ---
TSP_GEN_SEED=42
TSP_GEN_N_SERIES=5
TSP_GEN_N_HOURS=4368
TSP_GEN_START=2025-01-01T00:00:00
TSP_GEN_ANOMALY_RATE=0.002
